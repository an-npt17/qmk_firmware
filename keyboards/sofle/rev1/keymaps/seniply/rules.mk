# Seniply Keymap Configuration for Sofle V1

# Enable One-Shot Modifiers
ONESHOT_ENABLE = yes

# Enable Encoders
ENCODER_ENABLE = yes
ENCODER_MAP_ENABLE = yes


# Reduce firmware size
LTO_ENABLE = yes

VIA_ENABLE = yes
# Optional: Enable Caps Word (Seniply uses this)
CAPS_WORD_ENABLE = yes

# Disable unused features to save space
MOUSEKEY_ENABLE = no
RGBLIGHT_ENABLE = no
RGB_MATRIX_ENABLE = no
